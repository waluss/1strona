# TenderPlatform Docker Environment Variables
COMPOSE_PROJECT_NAME=tenderplatform_v2

# Host Port Mappings (Non-conflicting defaults)
DB_PORT=5433
BACKEND_PORT=8005
FRONTEND_PORT=8085
PROMETHEUS_PORT=9095
GRAFANA_PORT=3005

# Secrets & Operational Environment
SECRET_KEY=dev_secret_key_change_in_production
INITIAL_ADMIN_PASSWORD=admin
ENVIRONMENT=local
IMPORT_DRY_RUN_ENABLED=true
